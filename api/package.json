{
  "name": "api",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 8787",
    "build": "prisma generate && prisma db push && next build",
    "start": "next start -p 8787",
    "start:prod": "prisma generate && prisma db push && next start -p 8787",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "db:deploy": "prisma generate && prisma db push"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "^6.2.8",
    "next": "15.5.22",
    "nodemailer": "^9.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "prisma": "^5.22.0",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
